From befb3f2bd60c5ef20635d697ef2e327936e4b2f4 Mon Sep 17 00:00:00 2001
From: Viktor Semenov <suit.uanic@gmail.com>
Date: Wed, 26 Aug 2026 10:27:19 +0000
Subject: [PATCH 2/6] Add decode-script-vals-in CLI mode for decoding
 serialized script values

Adds a standalone tool invoked via --decode-script-vals-in to decode
and dump serialized script values outside of a full game run.
---
 source/main.cpp                |   7 +++
 source/ps/DecodeScriptVals.cpp | 112 +++++++++++++++++++++++++++++++++
 source/ps/DecodeScriptVals.h   |  38 +++++++++++
 3 files changed, 157 insertions(+)
 create mode 100644 source/ps/DecodeScriptVals.cpp
 create mode 100644 source/ps/DecodeScriptVals.h

diff --git a/source/main.cpp b/source/main.cpp
index 0ad09c1815..961bb3340c 100644
--- a/source/main.cpp
+++ b/source/main.cpp
@@ -58,6 +58,7 @@ that of Atlas depending on commandline parameters.
 #include "ps/CLogger.h"
 #include "ps/CStr.h"
 #include "ps/ConfigDB.h"
+#include "ps/DecodeScriptVals.h"
 #include "ps/Filesystem.h"
 #include "ps/Game.h"
 #include "ps/GameSetup/Atlas.h"
@@ -658,6 +659,12 @@ static void RunGameOrAtlas(const std::span<const char* const> argv)
 		return;
 	}
 
+	if (args.Has("decode-script-vals-in"))
+	{
+		RunDecodeScriptVals(args);
+		return;
+	}
+
 	// run in archive-building mode if requested
 	if (args.Has("archivebuild"))
 	{
diff --git a/source/ps/DecodeScriptVals.cpp b/source/ps/DecodeScriptVals.cpp
new file mode 100644
index 0000000000..e1588890f9
--- /dev/null
+++ b/source/ps/DecodeScriptVals.cpp
@@ -0,0 +1,112 @@
