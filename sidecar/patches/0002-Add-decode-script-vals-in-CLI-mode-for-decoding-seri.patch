+
+#include "precompiled.h"
+
+#include "DecodeScriptVals.h"
+
+#include "lib/os_path.h"
+#include "ps/CLogger.h"
+#include "ps/CStr.h"
+#include "ps/GameSetup/CmdLineArgs.h"
+#include "scriptinterface/JSON.h"
+#include "scriptinterface/ScriptContext.h"
+#include "scriptinterface/ScriptInterface.h"
+#include "scriptinterface/ScriptRequest.h"
+#include "simulation2/serialization/StdDeserializer.h"
+
+#include <exception>
+#include <fstream>
+#include <sodium.h>
+#include <sstream>
+#include <vector>
+
+void RunDecodeScriptVals(const CmdLineArgs& args)
+{
+	const OsPath inputPath(args.Get("decode-script-vals-in"));
+	const OsPath outputPath(args.Get("decode-script-vals-out"));
+	if (outputPath.empty())
+	{
+		LOGERROR("-decode-script-vals-in requires -decode-script-vals-out=<file>");
+		return;
+	}
+
+	std::ifstream in(OsString(inputPath));
+	if (!in.is_open())
+	{
+		LOGERROR("Could not open '%s' for reading.", inputPath.string8().c_str());
+		return;
+	}
+
+	if (sodium_init() < 0)
+	{
+		LOGERROR("Failed to initialize libsodium.");
+		return;
+	}
+
+	std::ofstream out(OsString(outputPath), std::ofstream::out | std::ofstream::trunc);
+	if (!out.is_open())
+	{
+		LOGERROR("Could not open '%s' for writing.", outputPath.string8().c_str());
+		return;
+	}
+
+	// No CGame/CSimulation2/VFS/mods needed: these payloads are plain JS
+	// objects (gameplay commands, game-setup attributes), not simulation
+	// component state, so a bare context+interface is enough to deserialize
+	// and re-stringify them.
+	g_ScriptContext = ScriptContext::CreateContext();
+	{
+		ScriptInterface scriptInterface("Engine", "DecodeScriptVals", g_ScriptContext);
+		ScriptRequest rq(scriptInterface);
+
+		std::string b64;
+		while (std::getline(in, b64))
+		{
+			std::vector<unsigned char> raw(b64.size());
+			size_t rawLen = 0;
+			const bool decodedBase64 = !b64.empty() && sodium_base642bin(
+				raw.data(), raw.size(), b64.c_str(), b64.size(),
+				nullptr, &rawLen, nullptr, sodium_base64_VARIANT_ORIGINAL) == 0;
+
+			if (!decodedBase64)
+			{
+				out << "{\"__decode_error__\":true}\n";
+				continue;
+			}
+
+			try
+			{
+				std::istringstream stream(std::string(reinterpret_cast<char*>(raw.data()), rawLen));
+				CStdDeserializer deserializer(scriptInterface, stream);
+				JS::RootedValue value(rq.cx);
+				deserializer.ScriptVal("command", &value);
+				out << Script::StringifyJSON(rq, &value, false) << "\n";
+			}
+			catch (const std::exception& e)
+			{
+				LOGWARNING("Failed to decode script value: %s", e.what());
+				out << "{\"__decode_error__\":true}\n";
+			}
+		}
+	}
+
+	// Must be explicitly destructed here (matching CReplayPlayer::Replay,
+	// Replay.cpp:331) to avoid the ScriptEngine shutdown assertion that
+	// fires if a ScriptContext outlives it.
+	g_ScriptContext.reset();
+}
