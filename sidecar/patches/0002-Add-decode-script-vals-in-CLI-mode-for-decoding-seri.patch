+#ifndef INCLUDED_DECODESCRIPTVALS
+#define INCLUDED_DECODESCRIPTVALS
+
+class CmdLineArgs;
+
+/**
+ * Headless CLI mode: decode a batch of 0 A.D.'s own SpiderMonkey-serialized
+ * "ScriptVal" wire-format blobs (the format used for NMT_SIMULATION_COMMAND
+ * and NMT_GAME_SETUP "command" payloads, see CStdDeserializer::ScriptVal)
+ * into JSON, using the real engine deserializer rather than a reimplementation.
+ *
+ * Reads one base64-encoded blob per line from the file named by
+ * "-decode-script-vals-in" (order preserved) and writes one JSON line per
+ * blob, in the same order, to the file named by "-decode-script-vals-out".
+ * A blob that fails to decode (bad base64, or a malformed/unrecognised
+ * value) produces the line {"__decode_error__":true} rather than aborting
+ * the batch, so callers can still align output lines to input order.
+ */
+void RunDecodeScriptVals(const CmdLineArgs& args);
+
+#endif // INCLUDED_DECODESCRIPTVALS
