+/**
+ * Runs the session's own LobbyRatingReporter outside a session, standing in
+ * for the engine calls it makes, so the report is built exactly as the
+ * lobby client builds it. The report is the same for every player but for
+ * playerID, which is left for the dedicated server to fill in for the
+ * player it reports for.
+ */
+constexpr const char* RATING_REPORT_SCRIPT = R"(
+function BuildRatingReport(metadata, initAttributes)
+{
+	globalThis.g_InitAttributes = initAttributes;
+	globalThis.g_ResourceData = new Resources();
+	let report;
+	Engine.GetPlayerID = () => -1;
+	Engine.GuiInterfaceCall = () => ({
+		"timeElapsed": metadata.timeElapsed,
+		"players": metadata.playerStates
+	});
+	Engine.SendGameReport = data => { report = data; };
+	LobbyRatingReporter.prototype.onPlayersFinished([]);
+	if (report)
+		delete report.playerID;
+	return report;
+}
+)";
+
+/**
+ * Prints the game report the lobby client sends the rating bot at the end of
+ * a match, so a dedicated server can send it on a player's behalf. Printed
+ * next to every result; whether the match is rated is the server's call.
+ */
+void PrintRatingReport(const ScriptInterface& simInterface, JS::HandleValue metadata)
+{
+	// A neighbor of the simulation's interface, so the final state is read in
+	// place rather than cloned.
+	ScriptInterface scriptInterface("Engine", "RatingReport", simInterface);
+	ScriptRequest rq(scriptInterface);
+	JSI_VFS::RegisterScriptFunctions_ReadOnlySimulation(rq);
+
+	VfsPaths reportParts;
+	if (vfs::GetPathnames(g_VFS, L"gui/session/lobby/LobbyRatingReport/", L"*.js", reportParts) != INFO::OK)
+	{
+		LOGERROR("Could not list the rating report scripts");
+		return;
+	}
+	bool loaded = scriptInterface.LoadGlobalScripts() &&
+		scriptInterface.LoadGlobalScriptFile(L"gui/session/lobby/LobbyRatingReporter.js");
+	for (const VfsPath& path : reportParts)
+		loaded = loaded && scriptInterface.LoadGlobalScriptFile(path);
+	loaded = loaded && scriptInterface.LoadGlobalScript(L"sidecar/RatingReport.js", RATING_REPORT_SCRIPT);
+	if (!loaded)
+	{
+		LOGERROR("Could not load the rating reporter");
+		return;
+	}
+
+	JS::RootedValue initAttributes(rq.cx);
+	g_Game->GetSimulation2()->GetInitAttributes(&initAttributes);
+	JS::RootedValue global(rq.cx, rq.globalValue());
+	JS::RootedValue report(rq.cx);
+	if (!ScriptFunction::Call(rq, global, "BuildRatingReport", &report, metadata, initAttributes) ||
+		!report.isObject())
+	{
+		LOGERROR("Could not build the rating report");
+		return;
+	}
+
+	JS::RootedValue attributes(rq.cx);
+	Script::CreateObject(rq, &attributes);
+	for (const auto& [name, value] : GameReportAttributes(rq, report))
+		Script::SetProperty(rq, attributes, name.c_str(), value);
+	std::cout << "REPLAY_REPORT " << Script::StringifyJSON(rq, &attributes, false) << "\n";
+	std::cout.flush();
+}
 } // anonymous namespace
 
