+#ifndef INCLUDED_GAMEREPORTATTRIBUTES
+#define INCLUDED_GAMEREPORTATTRIBUTES
+
+#include "lib/utf8.h"
+#include "scriptinterface/Object.h"
+#include "scriptinterface/ScriptRequest.h"
+
+#include <map>
+#include <string>
+#include <utility>
+#include <vector>
+
+/**
+ * The attributes of the game report stanza, from the report object the
+ * session's LobbyRatingReporter builds. Header-only and free of gloox, so
+ * a dedicated server's replay sidecar can produce exactly the report the
+ * lobby client sends without linking the lobby.
+ */
+inline std::vector<std::pair<std::string, std::string>> GameReportAttributes(
+	const ScriptRequest& rq, JS::HandleValue data)
+{
+	std::vector<std::string> properties;
+	Script::EnumeratePropertyNames(rq, data, true, properties);
+
+	// https://gitea.wildfiregames.com/0ad/0ad/issues/8687
+	const std::map<std::string, std::string> mappings{
+		{ "civilianUnitsLost", "femaleCitizenUnitsLost" },
+		{ "civilianUnitsTrained", "femaleCitizenUnitsTrained" },
+		{ "enemyCivilianUnitsKilled", "enemyFemaleCitizenUnitsKilled"}
+	};
+	std::vector<std::pair<std::string, std::string>> attributes;
+	for (const std::string& p : properties)
+	{
+		std::wstring value;
+		Script::GetProperty(rq, data, p.c_str(), value);
+		if (mappings.contains(p))
+			attributes.emplace_back(mappings.at(p), utf8_from_wstring(value));
+		else
+			attributes.emplace_back(p, utf8_from_wstring(value));
+	}
+	return attributes;
+}
+
+#endif // INCLUDED_GAMEREPORTATTRIBUTES
