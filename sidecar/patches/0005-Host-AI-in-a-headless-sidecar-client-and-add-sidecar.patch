+std::string CComponentManager::DebugQuickHashBreakdown() const
+{
+	PROFILE2("DebugQuickHashBreakdown");
+
+	// The reduced ("quick") hash above folds three independent things into one
+	// digest: the simulation RNG, the entity-id counter, and every non-local
+	// Position. Two of those are global counters, so a single asymmetric
+	// Math.random() in the simulation realm or a single asymmetric non-local
+	// Engine.AddEntity diverges the digest permanently while the visible game
+	// stays identical -- which makes the digest alone nearly useless for
+	// telling those three causes apart after the fact. Emitting them
+	// separately turns "OOS on turn N" into "the entity-id counter drifted on
+	// turn N", which is a different quality of clue. Debug aid only: nothing
+	// reads this value, it never goes on the wire, and it must not be folded
+	// back into the hash.
+	CHashSerializer positions(m_ScriptInterface);
+
+	std::map<ComponentTypeId, std::map<entity_id_t, IComponent*> >::const_iterator cit =
+		m_ComponentsByTypeId.find(CID_Position);
+	size_t count = 0;
+	if (cit != m_ComponentsByTypeId.end())
+		for (std::map<entity_id_t, IComponent*>::const_iterator eit = cit->second.begin(); eit != cit->second.end(); ++eit)
+		{
+			if (ENTITY_IS_LOCAL(eit->first))
+				continue;
+			positions.NumberU32_Unbounded("entity id", eit->first);
+			eit->second->Serialize(positions);
+			++count;
+		}
+
+	std::stringstream out;
+	out << "rng=" << SerializeRNG(m_RNG)
+		<< " nextEntityId=" << m_NextEntityId
+		<< " positions=" << Hexify(std::string((const char*)positions.ComputeHash(), positions.GetHashLength()))
+		<< " positionCount=" << count;
+	return out.str();
+}
