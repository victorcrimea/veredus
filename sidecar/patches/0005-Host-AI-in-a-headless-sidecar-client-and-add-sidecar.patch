+void CReplayPlayer::DumpState(const OsPath& outPath, u32 turn) const
+{
+	std::stringstream stream;
+
+	// `commands.txt`'s "turn N" blocks are offset by one from wire-turn
+	// numbering: wire turn 0 never gets its own executed simulation step
+	// (CTurnManager::AddCommand rejects turn <= m_CurrentTurn, which starts
+	// at 0), so the dedicated server's `write_commands_txt` writes wire turn
+	// N+1's commands under block label N. Having just executed block `turn`,
+	// the simulation is therefore at wire turn `turn + 1` -- write that, to
+	// match what CNetClient::OnFileTransferRequest's live rejoin-state
+	// producer writes and CNetClient::LoadFinished's consumer expects.
+	u32 wireTurn = to_le32(turn + 1);
+	stream.write(reinterpret_cast<const char*>(&wireTurn), sizeof(wireTurn));
+
+	bool ok = g_Game->GetSimulation2()->SerializeState(stream);
+	ENSURE(ok);
+
+	std::string compressed;
+	CompressZLib(stream.str(), compressed, true);
+
+	std::ofstream outStream(OsString(outPath), std::ofstream::out | std::ofstream::trunc | std::ofstream::binary);
+	outStream << compressed;
+	outStream.close();
+
+	debug_printf("FILES| Rejoin state dumped at wire turn %u to '%s'\n", turn + 1, outPath.string8().c_str());
+}
