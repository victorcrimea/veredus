+bool CReplayPlayer::LoadInitialState(const OsPath& path, const bool viaTurnManager, u32& wireTurn) const
+{
+	std::ifstream inStream(OsString(path), std::ifstream::in | std::ifstream::binary);
+	if (!inStream.good())
+	{
+		LOGERROR("Could not open initial state '%s'", path.string8());
+		return false;
+	}
+	const std::string compressed((std::istreambuf_iterator<char>(inStream)), std::istreambuf_iterator<char>());
+	if (inStream.bad())
+	{
+		LOGERROR("Could not read initial state '%s'", path.string8());
+		return false;
+	}
+
+	// The inverse of CompressZLib with its length header, done by hand:
+	// DecompressZLib trusts the header and ENSUREs on corrupt data, and a
+	// failed ENSURE in a headless process can hang instead of exiting.
+	constexpr u32 maxStateBytes = 1024 * 1024 * 1024;
+	if (compressed.size() < 4 || read_le32(compressed.data()) < 4 || read_le32(compressed.data()) > maxStateBytes)
+	{
+		LOGERROR("Initial state '%s' is truncated or has an implausible size", path.string8());
+		return false;
+	}
+	std::string state(read_le32(compressed.data()), '\0');
+	uLongf destLen = state.size();
+	const int zok = uncompress(reinterpret_cast<Bytef*>(state.data()), &destLen,
+		reinterpret_cast<const Bytef*>(compressed.data()) + 4, compressed.size() - 4);
+	if (zok != Z_OK || destLen != state.size())
+	{
+		LOGERROR("Initial state '%s' did not decompress", path.string8());
+		return false;
+	}
+
+	wireTurn = read_le32(state.data());
+	std::stringstream stream(state.substr(4));
+	if (!g_Game->GetSimulation2()->DeserializeState(stream))
+	{
+		LOGERROR("Initial state '%s' did not deserialize", path.string8());
+		return false;
+	}
+
+	if (viaTurnManager)
+		g_Game->GetTurnManager()->ResetState(wireTurn, wireTurn);
+
+	debug_printf("FILES| Initial state loaded at wire turn %u from '%s'\n", wireTurn, path.string8().c_str());
+	return true;
+}
